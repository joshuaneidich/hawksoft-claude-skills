{
  "name": "hawksoft-agent-guidance",
  "version": "1.1.0",
  "description": "Reusable agent guidance and Claude plugin skills for HawkSoft workflows.",
  "scripts": {
    "validate:json": "node scripts/validate-json.mjs",
    "validate:skills": "node scripts/validate-skills.mjs",
    "sync:shared": "node scripts/sync-shared.mjs",
    "test": "npm run validate:json && npm run validate:skills && node scripts/sync-shared.mjs --check",
    "new-skill": "node scripts/skill-builder.mjs",
    "build": "node scripts/build.mjs",
    "build:claude": "node scripts/build.mjs claude",
    "build:claude:all": "node scripts/build.mjs claude --all",
    "build:claude:strict": "node scripts/build.mjs claude --variant strict",
    "build:claude:manual": "node scripts/build.mjs claude --variant manual",
    "build:chatgpt": "node scripts/build.mjs chatgpt"
  },
  "private": true,
  "type": "module"
}
